{
  "name": "Greece Sky and Weather Nowcast",
  "version": "0.3.2",
  "slug": "nowcast_ml",
  "description": "Greece Sky and Weather — local probabilistic nowcasting (PoP + P10/P50/P90)",
  "startup": "services",
  "boot": "auto",
  "init": false,
  "arch": ["aarch64"],
  "options": {
    "station_name": "your region name",
    "ecowitt_url": "http://192.168.1.174/get_livedata_info",
    "poll_interval_sec": 60,
    "training_interval_minutes": 60,
    "learning_enabled": true,
    "persist_model": true,
    "model_save_hour": 3,
    "log_level": "info",
    "mqtt_enabled": true,
    "mqtt_host": "core-mosquitto",
    "mqtt_port": 1883,
    "mqtt_username": "",
    "mqtt_password": "",
    "mqtt_topic_prefix": "greece_sky_and_weather_nowcast",
    "ha_discovery_prefix": "homeassistant"
  },
  "schema": {
    "station_name": "str",
    "ecowitt_url": "str",
    "poll_interval_sec": "int(10,3600)",
    "training_interval_minutes": "int(10,1440)",
    "learning_enabled": "bool",
    "persist_model": "bool",
    "model_save_hour": "int(0,23)",
    "log_level": "list(debug|info|warning|error)",
    "mqtt_enabled": "bool",
    "mqtt_host": "str",
    "mqtt_port": "int(1,65535)",
    "mqtt_username": "str",
    "mqtt_password": "password",
    "mqtt_topic_prefix": "str",
    "ha_discovery_prefix": "str"
  }
}
